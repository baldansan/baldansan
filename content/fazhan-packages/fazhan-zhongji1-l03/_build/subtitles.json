[
 {
  "chinese": "我5岁，他29岁。",
  "start": "00:08.0",
  "end": "00:12.2"
 },
 {
  "chinese": "有一天我哭着跑回家，边擦眼泪边对他说：\"我要改名字，我的名字不好听，而且班上有个小朋友的名字跟我的一样，我讨厌！\"",
  "start": "00:13.1",
  "end": "00:30.3"
 },
 {
  "chinese": "\"名字是你爷爷取的，怎么能说改就改？不行！\"他的态度很坚决。",
  "start": "00:31.7",
  "end": "00:40.8"
 },
 {
  "chinese": "于是，我开始哭闹，可是他根本就不理我。",
  "start": "00:41.7",
  "end": "00:47.1"
 },
 {
  "chinese": "我下定决心：他不答应，我就不吃饭，直到他答应为止。",
  "start": "00:47.9",
  "end": "00:55.2"
 },
 {
  "chinese": "果然，第三天，他只好宣布同意给我改名。",
  "start": "00:55.2",
  "end": "01:02.6"
 },
 {
  "chinese": "我胜利了，心里高兴得要命。",
  "start": "01:03.3",
  "end": "01:06.9"
 },
 {
  "chinese": "我16岁，他40岁。",
  "start": "01:09.0",
  "end": "01:12.6"
 },
 {
  "chinese": "一天吃晚饭时，我对他说：\"我不想上高中，我要上职业中学。\"",
  "start": "01:13.6",
  "end": "01:22.1"
 },
 {
  "chinese": "突然\"砰\"的一声巨响，我吓得不敢抬头。",
  "start": "01:22.1",
  "end": "01:28.8"
 },
 {
  "chinese": "我知道一场\"大战\"就要开始了。",
  "start": "01:29.7",
  "end": "01:33.4"
 },
 {
  "chinese": "果然，一分钟的沉默过后，\"战斗\"开始了。",
  "start": "01:34.3",
  "end": "01:40.1"
 },
 {
  "chinese": "\"谁让你去上职业中学的？！你眼里还有父母吗？如果你敢再提这件事情，我就打你！还有你！\"",
  "start": "01:41.0",
  "end": "01:51.9"
 },
 {
  "chinese": "他用手指着我那上小学六年级的弟弟接着说：\"别学你姐，好不容易考个好高中，居然不想去上。\"",
  "start": "01:51.9",
  "end": "02:04.7"
 },
 {
  "chinese": "\"有我什么事……\"弟弟不满地小声说。",
  "start": "02:06.6",
  "end": "02:11.9"
 },
 {
  "chinese": "这场\"战争\"我失败了。",
  "start": "02:13.1",
  "end": "02:16.1"
 },
 {
  "chinese": "我19岁，他43岁。",
  "start": "02:17.4",
  "end": "02:21.3"
 },
 {
  "chinese": "黑色的六月终于过去了。",
  "start": "02:22.4",
  "end": "02:25.4"
 },
 {
  "chinese": "走出考场我长出了一口气。",
  "start": "02:25.4",
  "end": "02:29.5"
 },
 {
  "chinese": "接下来是选择大学。",
  "start": "02:30.1",
  "end": "02:32.8"
 },
 {
  "chinese": "因为这件事，我和他又吵了好几天。",
  "start": "02:33.3",
  "end": "02:37.7"
 },
 {
  "chinese": "我想去外地上大学，好摆脱他的控制。",
  "start": "02:38.6",
  "end": "02:43.5"
 },
 {
  "chinese": "他却希望我在本地上学，理由是，女孩子离家近点儿好。",
  "start": "02:44.1",
  "end": "02:51.6"
 },
 {
  "chinese": "这事儿可不能听他的，我是成年人了，自己的事情可以自己做主。",
  "start": "02:52.4",
  "end": "03:01.0"
 },
 {
  "chinese": "在那几天，我们见面就吵。",
  "start": "03:01.9",
  "end": "03:05.2"
 },
 {
  "chinese": "后来妈妈受不了了：\"你们再这样，就到大街上去吵。\"",
  "start": "03:06.0",
  "end": "03:12.3"
 },
 {
  "chinese": "我们只得马上闭嘴。",
  "start": "03:13.4",
  "end": "03:15.8"
 },
 {
  "chinese": "到了填志愿那天，他跟着我去了学校。",
  "start": "03:17.0",
  "end": "03:21.8"
 },
 {
  "chinese": "一到学校，我就发现，他和我的老师在一个角落里谈话，后来老师找我谈话，说我报本地的大学是最保险的。",
  "start": "03:21.8",
  "end": "03:36.8"
 },
 {
  "chinese": "这一次我又失败了。",
  "start": "03:37.7",
  "end": "03:40.5"
 },
 {
  "chinese": "23岁那年我失恋了，那段日子，我不吃不喝，不和任何人交流，人瘦了一圈儿。",
  "start": "03:42.6",
  "end": "03:53.4"
 },
 {
  "chinese": "家里再也听不到我和爸爸的争吵声。",
  "start": "03:54.1",
  "end": "03:58.2"
 },
 {
  "chinese": "那年爸爸47岁。",
  "start": "03:58.9",
  "end": "04:01.5"
 },
 {
  "chinese": "有一天深夜，我感觉有人进了我的房间，是父亲。",
  "start": "04:02.5",
  "end": "04:09.0"
 },
 {
  "chinese": "他坐在床边对我说：\"孩子，我知道你心里难过，看见你这样不吃不喝，我更难过。",
  "start": "04:09.7",
  "end": "04:21.8"
 },
 {
  "chinese": "从小到大，我都希望把你培养成一个坚强自立的女孩子。",
  "start": "04:21.8",
  "end": "04:29.8"
 },
 {
  "chinese": "人的一生不可能总是一帆风顺的。",
  "start": "04:30.7",
  "end": "04:34.8"
 },
 {
  "chinese": "你知道我和你妈妈多心疼你、担心你吗？",
  "start": "04:35.4",
  "end": "04:40.5"
 },
 {
  "chinese": "忘记以前的一切，重新开始，好吗？",
  "start": "04:41.4",
  "end": "04:46.0"
 },
 {
  "chinese": "一定会有更好的、更适合你的人在等着你。\"",
  "start": "04:46.8",
  "end": "04:51.7"
 },
 {
  "chinese": "这是我第一次听到他用这么温柔的语气跟我说话，那声音明显老了很多。",
  "start": "04:52.8",
  "end": "05:03.2"
 },
 {
  "chinese": "说完，他就出去了，我感觉到他在擦眼泪。",
  "start": "05:04.3",
  "end": "05:11.2"
 },
 {
  "chinese": "那一夜，我哭得好伤心。",
  "start": "05:12.5",
  "end": "05:15.8"
 },
 {
  "chinese": "第二天早晨，我开始吃饭了，仍旧像从前一样故意说妈妈做的菜不可口，但这回父亲没有批评我。",
  "start": "05:15.8",
  "end": "05:30.6"
 },
 {
  "chinese": "我悄悄地看了他一眼，他的脸上竟然挂着笑容。",
  "start": "05:31.6",
  "end": "05:38.3"
 },
 {
  "chinese": "从小时候到现在，我和他之间的\"战争\"从来没有停止过。",
  "start": "05:40.1",
  "end": "05:47.4"
 },
 {
  "chinese": "现在，虽然我在外地工作，但我和父亲的\"战争\"却依然持续着，只不过是改变了\"战争\"的方式而已。",
  "start": "05:48.0",
  "end": "06:01.3"
 },
 {
  "chinese": "现在我们不是面对面，而是通过一根电话线进行着\"战争\"。",
  "start": "06:02.1",
  "end": "06:09.7"
 },
 {
  "chinese": "我依然喜欢和他吵，然后道歉；喜欢在某个深夜发条短信给他，上面只有五个字：\"老爸，我爱你！\"",
  "start": "06:09.7",
  "end": "06:25.1"
 }
]