# Supabase — public client variables only (optional locally; required on Vercel production)
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# Then fill in values from Supabase Dashboard → Settings → API.
#
# On Vercel: Project → Settings → Environment Variables
# Add both variables for Production (and Preview if needed).
#
# SUPABASE_SERVICE_ROLE_KEY: server-only (API routes, scripts). Vercel дээр нэмж болно —
# NEXT_PUBLIC_* биш, client bundle-д орохгүй. Supabase → Settings → API → service_role.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local ETL only (npm run load:hsk → scripts/load_hsk_words.mjs) — never add to Vercel
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Invitation email delivery (Phase 7 Step 16) — server-only, never expose to client
# EMAIL_PROVIDER: mock | resend | (unset = skip send, copy-link fallback)
# EMAIL_FROM: sender address shown to recipients (required when provider is configured)
# RESEND_API_KEY: required when EMAIL_PROVIDER=resend
# NEXT_PUBLIC_APP_URL: base URL for invite links (fallback: VERCEL_URL)

EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
NEXT_PUBLIC_APP_URL=

# Багшийн долоо хоногийн тайлан (Vercel Cron: app/api/cron/weekly-teacher-report) —
# RESEND_API_KEY, RESEND_FROM_EMAIL хоёул тохируулаагүй бол cron лог бичээд алгасна.
# RESEND_FROM_EMAIL: жишээ нь report@buunduu.app (Resend дээр баталгаажсан домэйн/sender байх ёстой)
RESEND_FROM_EMAIL=

# Vercel Cron endpoint-уудыг (weekly-teacher-report, inactive-student-check) гаднаас
# дуудахаас хамгаалах — Vercel Cron Authorization: Bearer header-ээр автоматаар дамжуулна.
# Тохируулаагүй бол cron endpoint нээлттэй үлдэнэ (local dev-д асуудалгүй).
CRON_SECRET=

# Идэвхгүй сурагчийн push мэдэгдэл (Web Push / VAPID) — app/api/cron/inactive-student-check.
# VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY/VAPID_SUBJECT тохируулаагүй бол cron болон
# /api/push/subscribe лог бичээд алгасна (алдаа шидэхгүй).
# Үүсгэх: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@buunduu.app

# NEXT_PUBLIC_VAPID_PUBLIC_KEY: client дээр push subscribe хийхэд хэрэгтэй — VAPID_PUBLIC_KEY-тэй
# ЯГ АДИЛ утга байх ёстой (public key тул client bundle-д орохоос аюулгүй).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
