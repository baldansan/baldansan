# Supabase — public client variables only (optional locally; required on Vercel production)
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# Then fill in values from Supabase Dashboard → Settings → API.
#
# On Vercel: Project → Settings → Environment Variables
# Add both variables for Production (and Preview if needed).
#
# NEVER add SUPABASE_SERVICE_ROLE_KEY or service_role to client env or Vercel for this app.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
