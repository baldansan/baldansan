/**
 * Чадварын каталог (skills + skill_edges) үүсгэх SQL гаргана.
 *   npx tsx scripts/skills/seed-skills.mts > supabase/seed/skills.sql
 * Эх: src/data/hsk30-durem.json (дүрэм, монгол тайлбартай), lib/mock-test/skill-tag-labels.ts (sk.*), voc.hsk1..6
 */
import { readFileSync } from "node:fs";
import { SKILL_TAG_LABELS_MN } from "../../lib/mock-test/skill-tag-labels";

type Point = { id: string; zh: string; pin?: string; gloss?: string; teacher?: string; structure?: string };
type Level = { levelId: string; title: string; points: Point[] };
const course = JSON.parse(readFileSync("src/data/hsk30-durem.json", "utf8")) as { levels: Level[] };

const q = (s: string | null | undefined) => (s == null ? "null" : `'${String(s).replace(/'/g, "''")}'`);
const rows: string[] = [];
const edges: string[] = [];

// 1) Дүрмийн цэгүүд
for (const lv of course.levels) {
  const level = lv.levelId === "hsk7-9" ? 7 : Number(lv.levelId.replace("hsk", ""));
  lv.points.forEach((p, i) => {
    const id = `gr.${p.id}`;
    const desc = [p.gloss, p.structure ? `Бүтэц: ${p.structure}` : null].filter(Boolean).join(" · ");
    rows.push(`(${q(id)}, 'grammar', ${level}, ${q(p.zh)}, ${q(p.zh)}, ${q(desc)}, ${i + 1})`);
    edges.push(`(${q(id)}, 'explains', 'hsk30_point', ${q(p.id)}, ${q(`/review/grammar/hsk30/${lv.levelId}/${p.id}`)})`);
  });
}

// 2) Шалгалтын ур чадвар (sk.*) — бүх түвшинд нийтлэг, hsk_level null
const SK_ORDER = ["listening", "reading", "writing"];
Object.entries(SKILL_TAG_LABELS_MN)
  .filter(([k]) => k.startsWith("sk."))
  .sort(([a], [b]) => SK_ORDER.indexOf(a.split(".")[1]) - SK_ORDER.indexOf(b.split(".")[1]) || a.localeCompare(b))
  .forEach(([k, label], i) => {
    rows.push(`(${q(k)}, 'skill', null, ${q(label)}, null, null, ${i + 1})`);
  });

// 3) Түвшний үгийн сан
const VOC_N: Record<number, number> = { 1: 500, 2: 772, 3: 973, 4: 1000, 5: 1071, 6: 1140 };
for (let l = 1; l <= 6; l++) {
  rows.push(`(${q(`voc.hsk${l}`)}, 'vocab_level', ${l}, ${q(`HSK ${l} үгийн сан`)}, null, ${q(`HSK 3.0 ${l}-р түвшний ${VOC_N[l]} орчим үг`)}, ${l})`);
}

console.log("-- generated by scripts/skills/seed-skills.mts");
console.log("insert into public.skills (id, kind, hsk_level, name_mn, name_zh, desc_mn, sort) values");
console.log(rows.join(",\n"));
console.log("on conflict (id) do update set kind = excluded.kind, hsk_level = excluded.hsk_level, name_mn = excluded.name_mn, name_zh = excluded.name_zh, desc_mn = excluded.desc_mn, sort = excluded.sort, updated_at = now();");
console.log();
console.log("insert into public.skill_edges (skill_id, rel, ref_type, ref_id, locator) values");
console.log(edges.join(",\n"));
console.log("on conflict (skill_id, rel, ref_type, ref_id) do update set locator = excluded.locator;");
